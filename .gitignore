## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio / Rider
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.userprefs

# NuGet
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nupkg
**/packages.lock.json

# Application data
*.db
*.db-shm
*.db-wal

# Node
node_modules/
npm-debug.log
yarn-error.log

# OS
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# generated code
solutions/
site/

# Orphaned projects (not in solution)
/src/AiToolkit.Api/
/src/AiToolkit.Infrastructure/

# Application secrets
/src/ImagineWeb.Api/appsettings.json
/src/ImagineWeb.Api/appsettings.Development.json
